{% extends "base.html.twig" %}
{% block title %} 
Liste des Utilisateurs
{% endblock %}
{% block body %}
<ul>
    {% if users %}
    <p>Liste des Utilisateurs </p>
            {% for user in users %}
        <li>{{ user.firstname }} - {{ user.lastname }} / {{ user.email }}</li>
        <a href="{{ path('app_users_id', {id: user.id }) }}">Détail</a>
        {% endfor %}
    {% else %}
    <p>La liste est vide</p>
        {% endif %}
</ul>
{% endblock %}    