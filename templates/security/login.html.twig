{% extends 'base.html.twig' %}

{% block title %}Connexion - Bibliothèque{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto px-4 py-10">
    {# Bouton retour à l'accueil #}
    <div class="mb-6">
        <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-white/90 text-sky-900 font-semibold rounded-lg shadow hover:bg-white transition">
            <span>&larr;</span> Retour à l'accueil
        </a>
    </div>

    <div class="bg-white text-slate-800 rounded-2xl shadow-xl p-8 sm:p-10">
        {# En-tête de la carte #}
        <div class="text-center mb-8">
            <div class="w-16 h-16 mx-auto mb-4 bg-sky-50 rounded-full flex items-center justify-center">
                <img class="w-9 h-9 object-contain" src="{{ asset('images/book.svg') }}" alt="Logo EasyBook">
            </div>
            <h1 class="text-3xl font-bold text-slate-900 mb-2">Connexion</h1>
            <p class="text-slate-500 text-sm">Accédez à votre espace membre EasyBook</p>
        </div>

        {# Message d'erreur d'authentification #}
        {% if error %}
            <div class="mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {# Bandeau si déjà connecté #}
        {% if app.user %}
            <div class="mb-6 p-4 rounded-xl bg-sky-50 border border-sky-200 text-sky-800 text-sm flex items-center justify-between gap-4">
                <span>Connecté en tant que <strong>{{ app.user.userIdentifier }}</strong></span>
                <a href="{{ logout_path() }}" data-turbo="false" data-turbo-prefetch="false" class="font-semibold text-sky-700 hover:underline">Se déconnecter</a>
            </div>
        {% endif %}

        <form method="post" class="space-y-5">
            <div>
                <label for="username" class="block text-sm font-semibold text-slate-700 mb-1.5">Adresse e-mail</label>
                <input
                    type="email"
                    value="{{ last_username }}"
                    name="_username"
                    id="username"
                    class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:bg-white transition"
                    placeholder="jean.dupont@exemple.fr"
                    autocomplete="email"
                    required
                    autofocus
                >
            </div>

            <div>
                <label for="password" class="block text-sm font-semibold text-slate-700 mb-1.5">Mot de passe</label>
                <input
                    type="password"
                    name="_password"
                    id="password"
                    class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500 focus:bg-white transition"
                    placeholder="••••••••"
                    autocomplete="current-password"
                    required
                >
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <div class="pt-3">
                <button class="w-full py-3 px-6 bg-sky-600 text-white font-semibold rounded-xl shadow-md hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2 transition cursor-pointer" type="submit">
                    Se connecter
                </button>
            </div>
        </form>

        <p class="mt-6 text-center text-sm text-slate-500">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="font-semibold text-sky-600 hover:underline">S'inscrire</a>
        </p>
    </div>
</div>
{% endblock %}

