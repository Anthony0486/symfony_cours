{% extends "base.html.twig" %}
{% block title %} 
Liste des Utilisateurs
{% endblock %}
{% block body %}
<ul>
    {% if users %}
    <h1>Liste des Utilisateurs </h1>
            {% for user in users %}
        <li><a href="{{ path('app_user_id', {id: user.id }) }}"> {{ user.firstname }} {{ user.lastname }}</a></li>
        <P> {{ user.email }} </P>
        <hr>
        {% endfor %}
    {% else %}
    <p>La liste est vide</p>
        {% endif %}
</ul>
{% endblock %}    