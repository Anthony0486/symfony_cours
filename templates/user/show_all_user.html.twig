{% extends "base.html.twig" %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 py-10">
    {# Bouton retour à l'accueil #}
    <div class="mb-6">
        <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-white/90 text-sky-900 font-semibold rounded-lg shadow hover:bg-white transition">
            <span>&larr;</span> Retour à l'accueil
        </a>
    </div>

    {# En-tête de la page #}
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-slate-900">Utilisateurs</h1>
            <p class="text-slate-500 mt-1">Consultez la liste des membres inscrits dans la bibliothèque</p>
        </div>
        <span class="px-4 py-1.5 bg-sky-100 text-sky-800 text-sm font-semibold rounded-full shadow-xs">
            {{ users|length }} utilisateur{{ users|length > 1 ? 's' : '' }}
        </span>
    </div>

    {# Grille de 4 colonnes sur grand écran #}
    <section class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {% for user in users %}
            <article class="bg-white text-slate-800 rounded-2xl shadow-md hover:shadow-xl transition duration-200 overflow-hidden flex flex-col">
                <div class="p-6 flex flex-col flex-1">
                    <div class="flex items-center justify-between mb-4">
                        {# Avatar avec les initiales #}
                        <div class="w-12 h-12 rounded-full bg-sky-100 text-sky-700 font-bold text-lg flex items-center justify-center">
                            {{ user.firstname|first|upper }}{{ user.lastname|first|upper }}
                        </div>
                        <span class="text-xs font-medium text-slate-400">#{{ user.id }}</span>
                    </div>

                    <h2 class="font-bold text-xl text-slate-900 mb-1 truncate" title="{{ user.firstname }} {{ user.lastname }}">
                        {{ user.firstname }} {{ user.lastname }}
                    </h2>

                    <p class="text-sm text-slate-500 truncate mb-6" title="{{ user.email }}">
                        {{ user.email }}
                    </p>

                    <div class="mt-auto pt-4 border-t border-slate-100">
                        <a href="{{ path('app_user_id', {id: user.id}) }}" class="block w-full text-center px-4 py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-xl shadow-xs hover:bg-sky-700 transition">
                            Voir le profil &rarr;
                        </a>
                    </div>
                </div>
            </article>
        {% else %}
            <div class="col-span-full bg-white text-slate-800 rounded-2xl shadow-md p-10 text-center">
                <p class="text-lg font-medium text-slate-600">Aucun utilisateur inscrit pour le moment.</p>
            </div>
        {% endfor %}
    </section>
</div>
{% endblock %}
