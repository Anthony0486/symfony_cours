{# template component/infoCard;html.twig #}
{% props title%}
            <article class="bg-white text-slate-800 rounded-2xl shadow-md hover:shadow-xl transition duration-200 overflow-hidden flex flex-col">
                <div class="p-6 flex flex-col flex-1">
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-0.5 bg-sky-100 text-sky-800 text-xs font-semibold uppercase tracking-wide rounded-full">
                            Catégorie
                        </span>
                        <span class="text-xs font-medium text-slate-400">#{{ title.id }}</span>
                    </div>

                    <h2 class="font-bold text-xl text-slate-900 mb-6 capitalize">
                        {{ title.name }}
                    </h2>

                    <div class="mt-auto pt-4 border-t border-slate-100">
                        <a href="{{ path('app_category', {id: title.id}) }}" class="block w-full text-center px-4 py-2.5 bg-sky-600 text-white text-sm font-semibold rounded-xl shadow-xs hover:bg-sky-700 transition">
                            Voir le détail &rarr;
                        </a>
                    </div>
                </div>
            </article>