{# templates/components/Alert.html.twig #}
{% props message, type = 'info' %}

{% set typeStyles = {
    info: 'bg-sky-50 border-sky-200 text-sky-800',
    success: 'bg-emerald-50 border-emerald-200 text-emerald-800',
    warning: 'bg-amber-50 border-amber-200 text-amber-800',
    danger: 'bg-red-50 border-red-200 text-red-800',
    error: 'bg-red-50 border-red-200 text-red-800',
} %}

{% set badgeStyles = {
    info: 'bg-sky-100 text-sky-700',
    success: 'bg-emerald-100 text-emerald-700',
    warning: 'bg-amber-100 text-amber-700',
    danger: 'bg-red-100 text-red-700',
    error: 'bg-red-100 text-red-700',
} %}

{% set labels = {
    info: 'Info',
    success: 'Succès',
    warning: 'Attention',
    danger: 'Erreur',
    error: 'Erreur',
} %}

<div class="max-w-xl mx-auto my-3 px-4 py-3 rounded-xl border shadow-xs flex items-center gap-3 {{ typeStyles[type] ?? typeStyles.info }}" role="alert">
    <span class="px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider rounded-full {{ badgeStyles[type] ?? badgeStyles.info }}">
        {{ labels[type] ?? 'Info' }}
    </span>
    <span class="text-sm font-medium">
        {{ message }}
    </span>
</div>