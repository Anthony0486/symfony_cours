{% extends 'base.html.twig' %}

{% block title %}Liste des catégories{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto px-4 py-10">
    {# Bouton retour à l'accueil #}
    <div class="mb-6">
        <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-white/90 text-sky-900 font-semibold rounded-lg shadow hover:bg-white transition">
            <span>&larr;</span> Retour à l'accueil
        </a>
    </div>
    {# En-tête de la page #}
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-slate-900">Catégories</h1>
            <p class="text-slate-500 mt-1">Parcourez les différentes catégories d'ouvrages de la bibliothèque</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <span class="px-4 py-1.5 bg-sky-100 text-sky-800 text-sm font-semibold rounded-full shadow-xs">
                {{ categories|length }} catégorie{{ categories|length > 1 ? 's' : '' }}
            </span>
            <a href="{{ path('app_categories_new') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-sky-600 text-white text-sm font-semibold rounded-xl shadow-xs hover:bg-sky-700 transition">
                <span>+</span> Créer une catégorie
            </a>
        </div>
    </div>

    {# Grille de 4 colonnes sur grand écran #}
    <section class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {% for category in categories %}
        <twig:InfoCard :title="category"/>
        {% else %}
            <div class="col-span-full bg-white text-slate-800 rounded-2xl shadow-md p-10 text-center">
                <p class="text-lg font-medium text-slate-600">Aucune catégorie disponible pour le moment.</p>
            </div>
        {% endfor %}
    </section>
</div>
{% endblock %}
