{% extends "base.html.twig" %}

{% block title %}Modifier une catégorie - Bibliothèque{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto px-4 py-10">
    {# Bouton retour aux catégories #}
    <div class="mb-6">
        <a href="{{ path('app_categories') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-white/90 text-sky-900 font-semibold rounded-lg shadow hover:bg-white transition">
            <span>&larr;</span> Retour aux catégories
        </a>
    </div>

    {% include "components/toaster.html.twig" %}

    <div class="bg-white text-slate-800 rounded-2xl shadow-xl p-8 sm:p-10">
        {# En-tête de la carte #}
        <div class="text-center mb-8">
            <div class="w-16 h-16 mx-auto mb-4 bg-sky-50 rounded-full flex items-center justify-center">
                <img class="w-9 h-9 object-contain" src="{{ asset('images/book.svg') }}" alt="Logo EasyBook">
            </div>
            <h1 class="text-3xl font-bold text-slate-900 mb-2">Modifier</h1>
            <p class="text-slate-500 text-sm">Mettre à jour le nom de la catégorie</p>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
            <div>
                {{ form_label(form.name) }}
                {{ form_widget(form.name) }}
                <div class="text-xs text-red-600 mt-1">{{ form_errors(form.name) }}</div>
            </div>

            <div class="pt-2">
                {{ form_widget(form.save) }}
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
