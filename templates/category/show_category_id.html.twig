{% extends 'base.html.twig' %}

{% block title %}
    {{ category ? category.name : 'Catégorie introuvable' }}
{% endblock %}

{% block body %}
<div class="max-w-3xl mx-auto px-4 py-10">
    {# Bouton retour #}
    <div class="mb-6">
        <a href="{{ path('app_categories') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-white/90 text-sky-900 font-semibold rounded-lg shadow hover:bg-white transition">
            <span>&larr;</span> Retour aux catégories
        </a>
    </div>

    {% if category %}
        <div class="bg-white text-slate-800 rounded-2xl shadow-xl overflow-hidden p-8 sm:p-10">
            <div class="flex items-center justify-between gap-4 mb-4">
                <span class="px-3 py-1 bg-sky-100 text-sky-800 text-xs font-semibold uppercase tracking-wide rounded-full">
                    Détail de la catégorie
                </span>
                <span class="text-sm font-semibold text-slate-400">
                    #{{ category.id }}
                </span>
            </div>

            <h1 class="text-3xl font-bold text-slate-900 capitalize mb-6">
                {{ category.name }}
            </h1>

            <div class="pt-6 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Identifiant</span>
                    <span class="font-semibold text-slate-800">#{{ category.id }}</span>
                </div>
                <div class="bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <span class="block text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">Nom de la catégorie</span>
                    <span class="font-semibold text-slate-800 capitalize">{{ category.name }}</span>
                </div>
            </div>
        </div>
    {% else %}
        <div class="bg-white text-slate-800 rounded-2xl shadow-xl p-10 text-center">
            <h1 class="text-2xl font-bold text-red-600 mb-2">Catégorie introuvable</h1>
            <p class="text-slate-500 mb-6">Cette catégorie n'existe pas dans la bibliothèque.</p>
            <a href="{{ path('app_categories') }}" class="inline-block px-5 py-2.5 bg-sky-600 text-white font-semibold rounded-lg shadow hover:bg-sky-700 transition">
                Retour aux catégories
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
