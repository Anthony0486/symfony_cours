{% extends "base.html.twig" %}

{% block title %}Ajouter un livre - Bibliothèque{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto px-4 py-10">
    {# Bouton retour aux livres #}
    <div class="mb-6">
        <a href="{{ path('app_books') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-white/90 text-sky-900 font-semibold rounded-lg shadow hover:bg-white transition">
            <span>&larr;</span> Retour aux livres
        </a>
    </div>

    {% include "components/toaster.html.twig" %}

    <div class="bg-white text-slate-800 rounded-2xl shadow-xl p-8 sm:p-10">
        {# En-tête de la carte #}
        <div class="text-center mb-8">
            <div class="w-16 h-16 mx-auto mb-4 bg-sky-50 rounded-full flex items-center justify-center">
                <img class="w-9 h-9 object-contain" src="{{ asset('images/book.svg') }}" alt="Logo EasyBook">
            </div>
            <h1 class="text-3xl font-bold text-slate-900 mb-2">Nouveau livre</h1>
            <p class="text-slate-500 text-sm">Ajoutez un nouvel ouvrage pour enrichir la bibliothèque</p>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}
            {# Titre #}
            <div>
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                <div class="text-xs text-red-600 mt-1">{{ form_errors(form.title) }}</div>
            </div>

            {# Auteur et Date de publication sur 2 colonnes #}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    {{ form_label(form.author) }}
                    {{ form_widget(form.author) }}
                    <div class="text-xs text-red-600 mt-1">{{ form_errors(form.author) }}</div>
                </div>
                <div>
                    {{ form_label(form.publishAt) }}
                    {{ form_widget(form.publishAt) }}
                    <div class="text-xs text-red-600 mt-1">{{ form_errors(form.publishAt) }}</div>
                </div>
            </div>

            {# Résumé #}
            <div>
                {{ form_label(form.resume) }}
                {{ form_widget(form.resume) }}
                <div class="text-xs text-red-600 mt-1">{{ form_errors(form.resume) }}</div>
            </div>

            {# Catégories #}
            <div>
                {{ form_label(form.categories) }}
                {{ form_widget(form.categories) }}
                <p class="text-xs text-slate-400 mt-1">Maintenez Ctrl (ou Cmd) pour sélectionner plusieurs catégories.</p>
                <div class="text-xs text-red-600 mt-1">{{ form_errors(form.categories) }}</div>
            </div>

            {# Bouton de soumission #}
            <div class="pt-3">
                {{ form_widget(form.save) }}
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}