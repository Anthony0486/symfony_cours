{% extends "base.html.twig" %}

{% block title %}
    {{ book ? book.title : 'Livre introuvable' }}
{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto px-4 py-10">
    {# Bouton retour #}
    <div class="mb-6">
        <a href="{{ path('app_books') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-white/90 text-sky-900 font-semibold rounded-lg shadow hover:bg-white transition">
            <span>&larr;</span> Retour à la liste des livres
        </a>
    </div>

    {% if book %}
        <div class="bg-white text-slate-800 rounded-2xl shadow-xl overflow-hidden md:flex">
            {# Colonne image #}
            <div class="md:w-1/3 bg-slate-100 flex items-center justify-center p-8">
                <img class="w-48 h-auto object-contain drop-shadow-md" src="{{ asset('images/book.svg') }}" alt="{{ book.title }}">
            </div>

            {# Colonne informations #}
            <div class="p-8 md:w-2/3 flex flex-col justify-between">
                <div>
                    {# Badges des catégories #}
                    {% if book.categories is not empty %}
                        <div class="flex flex-wrap gap-2 mb-4">
                            {% for category in book.categories %}
                                <span class="px-3 py-1 bg-sky-100 text-sky-800 text-xs font-semibold uppercase tracking-wide rounded-full">
                                    {{ category.name }}
                                </span>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {# Titre et Auteur #}
                    <h1 class="text-3xl font-bold text-slate-900 mb-1">{{ book.title }}</h1>
                    <p class="text-lg text-slate-500 italic mb-6">
                        Par <span class="font-medium text-slate-700">{{ book.author ?? 'Auteur inconnu' }}</span>
                    </p>

                    {# Résumé #}
                    <div class="mb-6">
                        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-2">Résumé</h2>
                        <p class="text-slate-600 leading-relaxed bg-slate-50 p-4 rounded-xl border border-slate-100">
                            {{ book.resume ?? 'Aucun résumé disponible pour ce livre.' }}
                        </p>
                    </div>
                </div>

                {# Pied de carte : Date de publication & Propriétaire #}
                <div class="pt-4 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4 text-sm text-slate-600">
                    <div>
                        <span class="font-semibold text-slate-800">Publié le :</span>
                        {{ book.publishAt ? book.publishAt|date("d/m/Y") : 'Non renseigné' }}
                    </div>
                    {% if book.user %}
                        <div class="bg-slate-100 px-3 py-1.5 rounded-lg">
                            <span class="font-semibold text-slate-800">Propriétaire :</span>
                            {{ book.user.firstname }} {{ book.user.lastname }}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    {% else %}
        <div class="bg-white text-slate-800 rounded-2xl shadow-xl p-10 text-center">
            <h1 class="text-2xl font-bold text-red-600 mb-2">Ce livre n'existe pas</h1>
            <p class="text-slate-500 mb-6">Le livre que vous recherchez est introuvable ou a été supprimé.</p>
            <a href="{{ path('app_books') }}" class="inline-block px-5 py-2.5 bg-sky-600 text-white font-semibold rounded-lg shadow hover:bg-sky-700 transition">
                Retour à la liste
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}