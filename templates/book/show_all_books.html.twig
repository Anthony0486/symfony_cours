{% extends 'base.html.twig' %}
{% block title %}Books{% endblock %}
{% block body %}
<h1>Liste des Livres :</h1>
{% for book in books %}
<ul>
    <li>{{ book.title }}</li>
    <li>{{ book.author }}</li>
    <a href="{{ path('app_book_id', {id: book.id}) }}">
    Voir le détail
</a>
    </ul>
{% else %}
    <p>Aucun livre disponible.</p>
    {% endfor %}
{% endblock body %}